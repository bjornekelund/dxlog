/******/

/* Anzeige der Beitragsbilder */
/* DL1MGB 17.09.2022 */

.post-thumbnail { width: 100%; -webkit-transition: all 1s ease; -moz-transition: all 1s ease; transition: all 1s ease; }
.post-thumbnail { position: relative; margin-bottom: 1em; }
.post-thumbnail img { display: block; width: 100%; height: auto; }

#flexslider-featured .featured-img-thumb-xxlarge { max-height: 50px;overflow: hidden; }
#flexslider-featured .featured-img-thumb-xlarge { max-height: 50px;overflow: hidden; }
#flexslider-featured .featured-img-thumb-large { max-height: 30px;overflow: hidden; }

.image-container { position: relative; }
.image-container img { display: block; width: 30%; height: auto; }


/* Schriftfarbe der Menüeinträge) */
/* DL1MGB 17.09.2022 */

#nav-topbar .nav li a { color: #fff; color: #eee; /*rgba(255,255,255,0.8);*/ }

#footer-bottom #copyright,#footer-bottom #credit { color: #fff; color: #fff; font-size: 0.9375em; line-height: 1.5em; }

/*Definition der Tabellen für FC- und Contestergebnisse */
/* DL1MGB 16.10.2022 */
table.fctab {margin-top: 1.5em;}
table.fctab tr { background: #ffffff;}

table.fctab tr:hover { background: #dddddd;}

table.fctab tr.alt {background: #ffffff;}
table.fctab tr.alt:hover {background: #dddddd;}

table.fctab td {vertical-align:center;}
table.fctab td.noborder {border-bottom: 0px;}

table.fctab td.fctabl {text-align: left;vertical-align:center;}
table.fctab td.fctabr {text-align: right;vertical-align:center;}

table.fctab td.fctabl-bold {text-align: left;font-weight: 600;vertical-align:center;}
table.fctab td.fctabr-bold {text-align: right;font-weight: 600;vertical-align:center;}

table.fctab th {text-align: center;border-top: 0px solid #ffffff;vertical-align:center;}
table.fctab th.fctabl {text-align: left;vertical-align:center;}
table.fctab th.fctabr {text-align: right;vertical-align:center;}

table.fctab td.fctab-blank {border-color: #FFFFFF;}

table.fctab table.cattab, th.cattab {font-size: 1.15em; font-style: italic; text-align: left !important; padding-left: 10px; vertical-align: top;}


/* Schrift der Widget-Überschrift angepasst */
/* 22.10.2022 DL1MGB */
/* main.min.css | https://bcc.telegraphy.de/wp-content/themes/hueman-pro/assets/front/css/main.min.css?ver=1.4.24 */

.widget > h3 {
  /* font-weight: 400; */
  font-weight: 600;
	font-size: 1.4em;
}


/*****/
/* NextGen Gallery */
/*****/

/* Für die Galerie, damit die Breadcrumb-Separator ordentlich angezeigt werden */
/* 17.09.2022 DL1MGB */

ul.ngg-breadcrumbs > li::marker {
	content: none !important;
}

/* Anpassung der Schriftgröße / kein uppercase bei den Brotkrümeln */
/* 21.10.2022 DL1MGB */

article .entry .ngg-breadcrumb {
	font-size: 20px;
	color: #333333;
}
article .entry .ngg-breadcrumb a {
    text-decoration: none;
    font-size: 20px;
	  font-weight: 555;
	  color: #666666;
}


/* Anpassung der Schrift der Albenbeschriftung */
/* 22.10.2022 DL1MGB */

article .caption_link a, .caption_link a:visited, .caption_link a:hover {
    text-decoration: none;
    font-weight: 555;	
}

/* Anpassung der Schrift der Bilderbeschriftung in der Lightbox */
/* 22.10.2022 DL1MGB */
.galleria-theme-nextgen_pro_lightbox .galleria-info-title {
    font: bold 14px/1.1 "Arial", sans-serif;
    text-transform: none;
}

.galleria-theme-nextgen_pro_lightbox .galleria-info-description {
    margin: 0 16px 16px 16px;
    color: #bbb;
    font: 14px "Arial", sans-serif;
    text-align: left;
    order: 3;
    width: 100%;
    line-height: 1.5;
}

/* Bilder der Mitglieder */
.memberpic {
  display: block;
  margin-left: auto;
  margin-right: auto;
  max-width: 300px;
  outline-style: solid;
  outline-width: 1px;
  outline-color: #AAAAAA;
}

/* CSS für Green Forms */
	.inputform {
		text-transform:uppercase;
}

::placeholder { /* Chrome, Firefox, Opera, Safari 10.1+ */
  text-transform: none;
}

:-ms-input-placeholder { /* Internet Explorer 10-11 */
  text-transform: none;
}

::-ms-input-placeholder { /* Microsoft Edge */
  text-transform: none;
}

.attentiontipp {
  background-color: #fdede9;
  padding: 20px;
  margin-top: 40px;
  margin-bottom: 40px;
  border-radius: 10px;
}		</style>
		            <style id="grids-css" type="text/css">
                .post-list .grid-item {float: left; }
                .cols-1 .grid-item { width: 100%; }
                .cols-2 .grid-item { width: 50%; }
                .cols-3 .grid-item { width: 33.3%; }
                .cols-4 .grid-item { width: 25%; }
                @media only screen and (max-width: 719px) {
                      #grid-wrapper .grid-item{
                        width: 100%;
                      }
                }
            </style>
            </head>

