gawk '
BEGIN {
  FS="=";
}
{
  if (substr($1, 1, 1) ~ /[A-Z,0-9]/) {
    distlist[$1] = ($2 == "NR") ? "NK" : $2;
    callist[$1] = $1;
  }
}
END {
  for (c in callist)
    if (distlist[c] != "")
      printf("%s %s\n", c, distlist[c]);
}' ukeidx_db.txt | sort > ukeidx_db_1.txt

gawk '
BEGIN {
  FS=",";
}
{
  if (substr($1,1,1) ~ /[A-Z,0-9]/) {
    distlist[$1] = ($2 == "NR") ? "NK" : $2;
    callist[$1]=$1;
  }
}
END {
  for (c in callist)
    if (distlist[c] != "")
      printf("%s %s\n", c, distlist[c]);
}' UKEIDXCW.txt | sort > UKEIDXCW_1.txt

gawk '
BEGIN {
  FS=" ";
}
{
  if (callist[$1] != "" && distlist[$1] != $2)
    printf("Call %s: %s replaced with %s\n", $1, distlist[$1], $2) > "/dev/stderr";
  distlist[$1]=$2;
  callist[$1]=$1;
}
END {
  printf("#0 Prefill database for UKEIDX contest.\n");
  printf("#1 By SM7IUN 2020-02-23\n");
  printf("#2 Based on work by EI3JE and VE2FK.\n");
  printf("#3\n");

  for (c in callist)
    if (distlist[c] != "")
      printf("%s=%s\n", c, distlist[c]);
}' ukeidx_db_1.txt UKEIDXCW_1.txt | sort > ukeidx_db_new.txt

unix2dos ukeidx_db_new.txt

